# =================================================================
# LEARNING OS — ENVIRONMENT CONFIGURATION (.env)
# =================================================================

# -----------------------------------------------------------------
# 1. AI ENGINE (Google Gemini API / Vertex AI)
# -----------------------------------------------------------------
# Standard Gemini API Key (Required for LLM generation, tutor & distilling)
GEMINI_API_KEY=

# Optional custom model override (Defaults: gemini-2.5-flash, gemini-2.5-pro, gemini-1.5-flash)
GEMINI_MODEL=

# Google Cloud Vertex AI configuration (Optional - only if using Vertex AI enterprise mode)
USE_VERTEX_AI=false
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1
GOOGLE_SERVICE_ACCOUNT_JSON=

# -----------------------------------------------------------------
# 2. FIREBASE & CLOUD FIRESTORE (Database & Auth)
# -----------------------------------------------------------------
# Note: If firebase-applet-config.json is present, it will be used automatically.
# You can also override individual settings below:
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=

# Server-side Firebase aliases
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_APP_ID=

# -----------------------------------------------------------------
# 3. ACADEMIC GROUNDING & EXTERNAL SERVICES (Optional)
# -----------------------------------------------------------------
# OpenAlex API Key (Optional — boosts rate limits for open academic papers & textbooks)
OPENALEX_API_KEY=

# Apify API Token (Optional — enables live scrapers for Wikibooks & niche archives)
APIFY_API_TOKEN=

# Daily.co API Key (Optional — for WebRTC P2P video rooms; Jitsi Meet WebRTC is used as automatic zero-config fallback)
DAILY_API_KEY=
