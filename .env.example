# =================================================================
# LEARNING OS — ENVIRONMENT CONFIGURATION (.env)
# =================================================================

# -----------------------------------------------------------------
# 1. AI ENGINE (Google Gemini API / Vertex AI)
# -----------------------------------------------------------------
# Standard Gemini API Key (Required for LLM generation, tutor & distilling)
GEMINI_API_KEY=

# Optional custom model override (Default: gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Google Cloud Vertex AI configuration (Optional - only if using Vertex AI enterprise mode)
USE_VERTEX_AI=false
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1
GOOGLE_SERVICE_ACCOUNT_JSON=

# -----------------------------------------------------------------
# 2. FIREBASE & CLOUD FIRESTORE (Database & Auth)
# -----------------------------------------------------------------
# Note: If firebase-applet-config.json is present, it will be used automatically.
# You can also override individual settings below:
VITE_FIREBASE_API_KEY=AIzaSyDqLlaplvKzUyx9AyUauAKqQy34CP7wdIA
VITE_FIREBASE_AUTH_DOMAIN=project-231d23ad-e674-42a0-9f3.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=project-231d23ad-e674-42a0-9f3
VITE_FIREBASE_APP_ID=1:842691803820:web:c9aa75f2353ae7ddce7d09
VITE_FIREBASE_DATABASE_ID=ai-studio-learnosnow2-ab64ba35-972a-4aa3-b649-8f388fe6e5dc
VITE_FIREBASE_STORAGE_BUCKET=project-231d23ad-e674-42a0-9f3.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=842691803820

# Server-side Firebase aliases
FIREBASE_API_KEY=AIzaSyDqLlaplvKzUyx9AyUauAKqQy34CP7wdIA
FIREBASE_AUTH_DOMAIN=project-231d23ad-e674-42a0-9f3.firebaseapp.com
FIREBASE_PROJECT_ID=project-231d23ad-e674-42a0-9f3
FIREBASE_DATABASE_ID=ai-studio-learnosnow2-ab64ba35-972a-4aa3-b649-8f388fe6e5dc
