FIREBASE_APP_ID=1:842691803820:web:c9aa75f2353ae7ddce7d09

# -----------------------------------------------------------------
# 3. ACADEMIC GROUNDING & EXTERNAL SERVICES (Optional)
# -----------------------------------------------------------------
# OpenAlex API Key (Optional — boosts rate limits for open academic papers & textbooks)
OPENALEX_API_KEY=

# Apify API Token (Optional — enables live scrapers for Wikibooks & niche archives)
APIFY_API_TOKEN=

# Daily.co API Key (Optional — for WebRTC P2P video rooms; Jitsi Meet WebRTC is used as automatic zero-config fallback)
DAILY_API_KEY=
